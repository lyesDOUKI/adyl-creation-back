# ==========================
# Base de données
# ==========================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=adyl-creation
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ==========================
# Application
# ==========================

SERVER_PORT=8082
APP_BASE_URL=http://localhost:8082
APP_PHOTOS_STORAGE_PATH=/data/photos

# ==========================
# OIDC Configuration (Local Mock)
# ==========================

OIDC_ISSUER_URI=http://oidc-mock:8090/adyl-creation
OIDC_AUTHORIZATION_URL=http://localhost:8090/adyl-creation/authorize
OIDC_TOKEN_URL=http://localhost:8090/adyl-creation/token
OIDC_AUDIENCE=adyl-creation-api

UID=1000
GID=1000

# ============================================================
# Mail / Brevo SMTP
# ============================================================

MAILING_ENABLED=false
MAIL_HOST=
MAIL_PORT=

# Brevo SMTP credentials
MAIL_USERNAME=your_brevo_username
MAIL_PASSWORD=your_brevo_password

# Verified sender address in Brevo
MAIL_FROM=noreply@yourdomain.com

# Application administrator receiving notifications
ADMIN_EMAIL=admin@yourdomain.com